{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ProspectionCrm.Api"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prospectioncrm-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "retainedFileTimeLimit": "14.00:00:00"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "SourceCollectionWorker": {
    "Enabled": false,
    "IdleDelaySeconds": 5,
    "LeaseDurationSeconds": 300,
    "MaxAttempts": 3,
    "InitialRetryDelaySeconds": 60,
    "MaxRetryDelaySeconds": 900
  },
  "RssCollection": {
    "TimeoutSeconds": 15,
    "MaxResponseBytes": 2000000,
    "MaxRedirects": 3,
    "DefaultMaxItems": 100,
    "UserAgent": "ProspectionCrm/1.0"
  },
  "FileStorage": {
    "RootPath": "data/files"
  }
}
