@page "/companies/{Id:int}"

@inject CompanyService CompanyService
@inject ContactService ContactService

<PageTitle>Détail de l'entreprise</PageTitle>

<h1>Détail de l'entreprise</h1>

@if (isLoading)
{
    <p>Chargement de l'entreprise...</p>
}
else if (errorMessage is not null)
{
    <p>@errorMessage</p>
}
else if (company is null)
{
    <p>Entreprise introuvable.</p>
}
else
{
    <h2>@company.Name</h2>

    <p>Type : @company.Type</p>
    <p>Industrie : @company.Industry</p>
    <p>Localisation : @company.Location</p>
    <p>Site web : @company.Website</p>
    <p>Notes: @company.Notes</p>
    <h2>Contacts</h2>

    @if (!contacts.Any())
    {
        <p>Aucun contact associé à cette entreprise.</p>
    }
    else
    {
        @foreach (var contact in contacts)
        {
            <div>
                <p>
                    <NavLink href="@($"/contacts/{contact.Id}")">
                        @contact.FirstName @contact.LastName
                    </NavLink>
                </p>

                <p>Fonction : @contact.Role</p>
                <p>Email : @contact.Email</p>
            </div>
        }
    }

}

@code
{
    [Parameter]
    public int Id { get; set; }

    private CompanyDto? company;


    private List<ContactDto> contacts = [];

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            company = await CompanyService.GetByIdAsync(Id);

            if (company is not null)
            {
                contacts = await ContactService.GetByCompanyIdAsync(Id);
            }
        }
        catch (Exception)
        {
            errorMessage = "Impossible de charger l'entreprise.";
        }
        finally
        {
            isLoading = false;
        }
    }
}