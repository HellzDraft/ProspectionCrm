@page "/settings"
@inject PipelineApiService PipelineApiService

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<p>Parametres utilisateur.</p>

<div>
    <label>Nom de l'utilisateur</label>
    <InputText @bind-Value="UserName" />
</div>

<div>
    <label>Email</label>
    <InputText @bind-Value="Email" />
</div>

@if (isLoadingPipelines)
{
    <p>Chargement des pipelines...</p>
}
else if (pipelineError is not null)
{
    <p role="alert">@pipelineError</p>
    <button @onclick="LoadPipelinesAsync">Réessayer</button>
}
else
{
    <div>
        <label>Pipeline par défaut</label>
        <InputSelect @bind-Value="DefaultPipelineId">
            <option value="">Aucun pipeline par défaut</option>
            @foreach (var pipeline in pipelines)
            {
                <option value="@pipeline.Id">@pipeline.Name</option>
            }
        </InputSelect>
    </div>
}

<div>
    <label>Nombre d'éléments par page</label>

    <InputSelect @bind-Value="ItemsPage">
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="100">100</option>
    </InputSelect>
</div>

<div>
    <InputCheckbox @bind-Value="ShowCompletedActions" />
    <label>Afficher les actions terminées</label>
</div>

@code{

    private string UserName;

    private string Email;

    private Guid? DefaultPipelineId;
    private List<PipelineApiDto> pipelines = [];
    private bool isLoadingPipelines = true;
    private string? pipelineError;

    private int ItemsPage = 25;

    bool ShowCompletedActions;

    protected override Task OnInitializedAsync() => LoadPipelinesAsync();

    private async Task LoadPipelinesAsync()
    {
        isLoadingPipelines = true;
        pipelineError = null;
        try
        {
            pipelines = await PipelineApiService.GetAllAsync();
        }
        catch (Exception)
        {
            pipelineError = "Impossible de charger les pipelines.";
        }
        finally
        {
            isLoadingPipelines = false;
        }
    }
}
