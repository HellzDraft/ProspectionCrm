@page "/contacts/{Id:int}"

@inject ContactService ContactService
@inject CompanyService CompanyService

<PageTitle>Détail du contact</PageTitle>

<h1>Détail du contact</h1>

@if (isLoading)
{
    <p>Chargement du contact...</p>
}
else if (errorMessage is not null)
{
    <p>@errorMessage</p>
}
else if (contact is null)
{
    <p>Contact introuvable.</p>
}
else
{
    <h2>@contact.FirstName @contact.LastName</h2>
    <p>fonction : @contact.Role</p>
    <p>email : @contact.Email</p>
    @if (company is not null)
    {
        <p>
            Entreprise :
            <NavLink href="@($"/companies/{company.Id}")">
                @company.Name
            </NavLink>
        </p>
    }
}

@code
{
    [Parameter]
    public int Id { get; set; }

    private ContactDto? contact;

    private CompanyDto? company;

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            contact = await ContactService.GetByIdAsync(Id);

            if (contact is not null)
            {
                company = await CompanyService.GetByIdAsync(contact.CompanyId);
            }
        }
        catch (Exception)
        {
            errorMessage = "Impossible de charger le contact.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
