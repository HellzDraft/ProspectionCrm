@page "/opportunities/{Id:guid}/edit"
@inject OpportunityApiService OpportunityApiService
@inject PipelineApiService PipelineApiService
@inject NavigationManager NavigationManager

<PageTitle>Modifier une opportunité</PageTitle>
<h1>Modifier une opportunité</h1>

@if (isLoading)
{
    <p>Chargement...</p>
}
else if (notFound)
{
    <p>Opportunité introuvable.</p>
}
else if (loadErrorMessage is not null)
{
    <p role="alert">@loadErrorMessage</p>
    <button @onclick="LoadAsync">Réessayer</button>
}
else
{
    @if (errorMessage is not null)
    {
        <p role="alert">@errorMessage</p>
    }
    @if (original is not null)
    {
        <OpportunityApiForm @key="original.Id" Model="@model" Pipelines="@pipelines" OriginalStageId="@original.PipelineStageId"
                            IsSubmitting="@isSubmitting" OnValidSubmit="HandleValidSubmit" />
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    private OpportunityApiDto? original;
    private List<PipelineApiDto> pipelines = [];
    private string? loadErrorMessage;
    private OpportunityApiFormModel model = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private bool notFound;
    private string? errorMessage;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        notFound = false;
        errorMessage = null;
        original = null;
        loadErrorMessage = null;
        try
        {
            original = await OpportunityApiService.GetByIdAsync(Id);
            notFound = original is null;
            if (original is not null)
            {
                pipelines = await PipelineApiService.GetAllAsync(includeArchived: true);
                var pipeline = pipelines.FirstOrDefault(item => item.Stages.Any(stage => stage.Id == original.PipelineStageId));
                if (pipeline is null)
                {
                    loadErrorMessage = "Impossible de retrouver le pipeline et l'étape de cette opportunité.";
                    return;
                }
                model = new()
                {
                    Title = original.Title,
                    PipelineId = pipeline.Id,
                    PipelineStageId = original.PipelineStageId,
                    PriorityCode = original.PriorityCode,
                    Location = original.Location
                };
            }
        }
        catch (Exception)
        {
            loadErrorMessage = "Impossible de charger l'opportunité et ses pipelines.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting || isLoading || loadErrorMessage is not null || original is null)
            return;

        isSubmitting = true;
        errorMessage = null;
        try
        {
            var updated = await OpportunityApiService.UpdateAsync(
                original.Id, OpportunityApiWriteRequest.FromForm(model, original));
            if (!updated)
                notFound = true;
            else
                NavigationManager.NavigateTo("/opportunities?notice=updated");
        }
        catch (Exception)
        {
            errorMessage = "Impossible de modifier l'opportunité.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
