@page "/opportunities/create"

@inject OpportunityApiService OpportunityApiService

@inject NavigationManager NavigationManager

<PageTitle>Nouvelle opportunité</PageTitle>

<h1>Nouvelle opportunité</h1>

@if (errorMessage is not null)
{
    <p role="alert">@errorMessage</p>
}

<OpportunityApiForm Model="@model"
                 IsSubmitting="@isSubmitting"
                 SubmitText="Créer l'opportunité"
                 OnValidSubmit="HandleValidSubmit" />


@code {
    private OpportunityApiFormModel model = new();
    private bool isSubmitting;
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        if (isSubmitting)
            return;
        isSubmitting = true;
        errorMessage = null;
        try
        {
            await OpportunityApiService.CreateAsync(OpportunityApiWriteRequest.FromForm(model));
            NavigationManager.NavigateTo("/opportunities");
        }
        catch (Exception)
        {
            errorMessage = "Impossible de créer l'opportunité.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
