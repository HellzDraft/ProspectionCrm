@page "/"

@inject CrmTaskApiService CrmTaskApiService
@inject OpportunityApiService OpportunityApiService
@inject PipelineApiService PipelineApiService

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<p>Vue d'ensemble de votre prospection professionnelle.</p>

@if (isLoadingOpportunities)
{
    <p>Chargement des opportunités et des pipelines...</p>
}
else if (opportunitiesError is not null)
{
    <p role="alert">@opportunitiesError</p>
    <button @onclick="LoadOpportunityStatsAsync">Réessayer</button>
}
else
{
    <section>
        <h2>Résumé</h2>
        <div class="stats-grid">
            <DashboardStatCard Title="Opportunités actives" Value="@opportunities.Count" />
        </div>
    </section>
    <section>
        <h2>Répartition par pipeline</h2>
        <div class="stats-grid">
            @foreach (var pipeline in activePipelines)
            {
                <DashboardStatCard Title="@pipeline.Name" Value="@CountOpportunities(pipeline)" />
            }
        </div>
    </section>
}

<section aria-label="Relances à traiter">
    <h2>Relances à traiter</h2>
    @if (isLoadingRelances)
    {
        <p>Chargement des relances...</p>
    }
    else if (relancesError is not null)
    {
        <p role="alert">@relancesError</p>
        <button @onclick="LoadRelancesAsync">Réessayer</button>
    }
    else
    {
        <DashboardStatCard Title="Relances à traiter" Value="@dueTasks.Count" />
        @if (dueTasks.Count == 0)
        {
            <p>Aucune relance à traiter.</p>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>Relance</th><th>Échéance</th><th>Opportunité</th></tr></thead>
                <tbody>
                    @foreach (var task in dueTasks.Take(5))
                    {
                        <tr>
                            <td>@task.Title</td>
                            <td>@(task.DueAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td>@opportunityTitles.GetValueOrDefault(task.OpportunityId, "Opportunité indisponible")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    <NavLink href="/actions">Voir les actions / relances</NavLink>
</section>

@code {
    private List<OpportunityApiDto> opportunities = [];
    private List<PipelineApiDto> activePipelines = [];
    private bool isLoadingOpportunities = true;
    private string? opportunitiesError;

    private List<CrmTaskApiDto> dueTasks = [];
    private Dictionary<Guid, string> opportunityTitles = [];
    private bool isLoadingRelances = true;
    private string? relancesError;

    private int CountOpportunities(PipelineApiDto pipeline)
    {
        var stageIds = pipeline.Stages.Select(stage => stage.Id).ToHashSet();
        return opportunities.Count(opportunity => stageIds.Contains(opportunity.PipelineStageId));
    }

    protected override Task OnInitializedAsync()
        => Task.WhenAll(LoadOpportunityStatsAsync(), LoadRelancesAsync());

    private async Task LoadOpportunityStatsAsync()
    {
        isLoadingOpportunities = true;
        opportunitiesError = null;
        try
        {
            var opportunitiesRequest = OpportunityApiService.GetAllAsync();
            // Include historical stages so active opportunities on archived stages are still counted.
            var pipelinesRequest = PipelineApiService.GetAllAsync(includeArchived: true);
            await Task.WhenAll(opportunitiesRequest, pipelinesRequest);
            opportunities = await opportunitiesRequest;
            activePipelines = (await pipelinesRequest).Where(pipeline => pipeline.ArchivedAt is null).ToList();
        }
        catch (Exception)
        {
            opportunitiesError = "Impossible de charger les opportunités et les pipelines.";
        }
        finally
        {
            isLoadingOpportunities = false;
        }
    }

    private async Task LoadRelancesAsync()
    {
        isLoadingRelances = true;
        relancesError = null;
        try
        {
            dueTasks = await CrmTaskApiService.GetDueAsync();
            opportunityTitles = [];
            if (dueTasks.Count > 0)
            {
                try
                {
                    opportunityTitles = (await OpportunityApiService.GetAllAsync())
                        .ToDictionary(item => item.Id, item => item.Title);
                }
                catch (Exception)
                {
                    // The due count remains usable even if opportunity titles are unavailable.
                    opportunityTitles = [];
                }
            }
        }
        catch (Exception)
        {
            relancesError = "Impossible de charger les relances.";
        }
        finally
        {
            isLoadingRelances = false;
        }
    }
}
