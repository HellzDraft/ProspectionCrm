@page "/companies"
@inject CompanyApiService CompanyApiService

<PageTitle>Entreprises</PageTitle>
<h1>Entreprises</h1>
<NavLink href="/companies/create">Ajouter une entreprise</NavLink>

@if (successMessage is not null)
{
    <p role="status">@successMessage</p>
}
@if (operationErrorMessage is not null)
{
    <p role="alert">@operationErrorMessage</p>
}
@if (pendingDeletion is not null)
{
    <section aria-label="Confirmation de suppression">
        <p>Supprimer définitivement l'entreprise « @pendingDeletion.Name » ?
            Les contacts et opportunités liés seront conservés, mais leur association à cette entreprise sera retirée.</p>
        <button disabled="@(isDeleting || isLoading)" @onclick="ConfirmDeleteAsync">Confirmer la suppression</button>
        <button disabled="@isDeleting" @onclick="CancelDelete">Annuler</button>
        @if (isDeleting)
        {
            <p role="status">Suppression en cours...</p>
        }
    </section>
}
@if (errorMessage is not null)
{
    <p role="alert">@errorMessage</p>
    <button disabled="@(isLoading || isDeleting)" @onclick="LoadAsync">Réessayer</button>
}
@if (isLoading)
{
    <p>Chargement des entreprises...</p>
}
else if (hasLoaded)
{
    @if (items.Count == 0)
    {
        <p>Aucune entreprise.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Site web</th>
                    <th>Localisation</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Website</td>
                        <td>@item.Location</td>
                        <td>
                            <NavLink href="@($"/companies/{item.Id}/edit")">Modifier</NavLink>
                            <button disabled="@(isLoading || isDeleting)" @onclick="() => RequestDelete(item)">Supprimer</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<CompanyApiDto> items = [];
    private CompanyApiDto? pendingDeletion;
    private bool isLoading = true;
    private bool isDeleting;
    private bool hasLoaded;
    private string? errorMessage;
    private string? operationErrorMessage;
    private string? successMessage;

    [SupplyParameterFromQuery(Name = "notice")]
    public string? Notice { get; set; }

    protected override void OnParametersSet()
    {
        successMessage = Notice switch
        {
            "created" => "Entreprise créée.",
            "updated" => "Entreprise modifiée.",
            _ => null
        };
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            items = await CompanyApiService.GetAllAsync();
            hasLoaded = true;
        }
        catch (Exception)
        {
            errorMessage = "Impossible de charger les entreprises.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RequestDelete(CompanyApiDto item)
    {
        if (isDeleting || isLoading)
            return;
        pendingDeletion = item;
        operationErrorMessage = null;
        successMessage = null;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            pendingDeletion = null;
            operationErrorMessage = null;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (isDeleting || isLoading || pendingDeletion is null)
            return;
        isDeleting = true;
        operationErrorMessage = null;
        successMessage = null;
        try
        {
            var deleted = await CompanyApiService.DeleteAsync(pendingDeletion.Id);
            pendingDeletion = null;
            await LoadAsync();
            if (deleted)
                successMessage = "Entreprise supprimée.";
            else
                operationErrorMessage = "Cette entreprise n'existe plus.";
        }
        catch (Exception)
        {
            operationErrorMessage = "Impossible de supprimer l'entreprise.";
        }
        finally
        {
            isDeleting = false;
        }
    }
}
