@page "/opportunities"

@inject OpportunityApiService OpportunityApiService
@inject PipelineApiService PipelineApiService

<PageTitle>Opportunités</PageTitle>

<h1>Opportunités</h1>

<p>Liste des opportunités de prospection professionnelle.</p>

<NavLink href="/opportunities/create">Ajouter une opportunité</NavLink>

@if (successMessage is not null)
{
    <p role="status">@successMessage</p>
}
@if (operationErrorMessage is not null)
{
    <p role="alert">@operationErrorMessage</p>
}
@if (pendingArchive is not null)
{
    <section aria-label="Confirmation d'archivage">
        <p>Archiver l'opportunité « @pendingArchive.Title » ? Elle disparaîtra des vues actives mais ses données seront conservées.</p>
        <button disabled="@isArchiving" @onclick="ConfirmArchiveAsync">Confirmer l'archivage</button>
        <button disabled="@isArchiving" @onclick="CancelArchive">Annuler</button>
        @if (isArchiving)
        {
            <p role="status">Archivage en cours...</p>
        }
    </section>
}
@if (errorMessage is not null)
{
    <p role="alert">@errorMessage</p>
    <button disabled="@(isLoading || isArchiving)" @onclick="RetryLoadAsync">Réessayer</button>
}

<div class="view-selector">
    <button @onclick="ShowTableView">
        Tableau
    </button>

    <button @onclick="ShowKanbanView">
        Kanban
    </button>
</div>

<div class="opportunities-toolbar">
    <input type="text"
           placeholder="Rechercher une opportunité..."
           @bind="searchTerm"
           @bind:event="oninput"
           @bind:after="ResetPagination" />

    <select @bind="selectedPipelineId"
            @bind:after="ResetPagination">
        <option value="">Tous les pipelines</option>
        @foreach (var pipeline in pipelines.Where(item => item.ArchivedAt is null))
        {
            <option value="@pipeline.Id">@pipeline.Name</option>
        }
    </select>
</div>

@if (isLoading)
{
    <p>Chargement des opportunités...</p>
}
else if (errorMessage is not null && !hasLoaded)
{
}
else if (!filteredOpportunities.Any() && !isKanbanView)
{
    <p>Aucune opportunité ne correspond aux critères.</p>
}
else
{
    @if (isKanbanView && selectedPipelineId is null)
    {
        <p>Sélectionnez un pipeline pour afficher le Kanban.</p>
    }
    else if (isKanbanView)
    {
        <div class="kanban-board">
            @foreach (var stage in kanbanStages)
            {
                <section class="kanban-column">
                    <h2>
                        @GetStageName(stage.Id)
                    </h2>

                    @foreach (var opportunity in filteredOpportunities.Where(
                        opportunity => opportunity.PipelineStageId == stage.Id))
                    {
                        <OpportunityApiCard Opportunity="@opportunity" PipelineName="@GetPipelineName(opportunity.PipelineStageId)" StageName="@GetStageName(opportunity.PipelineStageId)" />
                    }
                </section>
            }
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>
                        <button @onclick='() => SetSort("Title")'>
                            Titre
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("CompanyId")'>
                            Entreprise
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("Pipeline")'>
                            Pipeline
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("Status")'>
                            Statut
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("Priority")'>
                            Priorité
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("Location")'>
                            Localisation
                        </button>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var opportunity in pagedOpportunities)
                {
                    <tr>
                        <td>@opportunity.Title</td>
                        <td>@OpportunityCodeHelper.GetCompanyLabel(opportunity.CompanyId)</td>

                        <td>
                            <span class="pipeline-badge">
                                @GetPipelineName(opportunity.PipelineStageId)
                            </span>
                        </td>

                        <td>@GetStageName(opportunity.PipelineStageId)</td>

                        <td>
                            <span class="priority-badge @GetPriorityClass(opportunity.PriorityCode)">
                                @OpportunityCodeHelper.GetPriorityLabel(opportunity.PriorityCode)
                            </span>
                        </td>

                        <td>@opportunity.Location</td>

                        <td>
                            <NavLink href="@($"/opportunities/{opportunity.Id}/edit")">Modifier</NavLink>
                            <button disabled="@(isArchiving || isLoading)" @onclick="() => RequestArchive(opportunity)">Archiver</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button @onclick="PreviousPage"
                    disabled="@(currentPage <= 1)">
                Précédent
            </button>

            <span>
                Page @currentPage sur @totalPages
            </span>

            <button @onclick="NextPage"
                    disabled="@(currentPage >= totalPages)">
                Suivant
            </button>
        </div>
    }
}

@code {
    private List<OpportunityApiDto> opportunities = [];

    private string searchTerm = string.Empty;

    private Guid? selectedPipelineId;
    private List<PipelineApiDto> pipelines = [];
    private Dictionary<Guid, PipelineApiDto> stagePipelines = [];
    private Dictionary<Guid, PipelineStageApiDto> stages = [];

    private string sortColumn = "Title";
    private bool sortAscending = true;

    private int currentPage = 1;
    private int pageSize = 2;

    private IEnumerable<OpportunityApiDto> filteredOpportunities =>
    opportunities.Where(opportunity =>
        (
            opportunity.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || (opportunity.Location?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
        )
        &&
        (
            selectedPipelineId is null
            || stagePipelines.GetValueOrDefault(opportunity.PipelineStageId)?.Id == selectedPipelineId.Value
        ));

    

    private string GetPriorityClass(string code)
    {
        return OpportunityCodeHelper.GetPriority(code) switch
        {
            OpportunityPriority.Low => "priority-low",
            OpportunityPriority.Normal => "priority-normal",
            OpportunityPriority.High => "priority-high",
            _ => string.Empty
        };
    }

    private string GetPipelineName(Guid stageId) => stagePipelines.TryGetValue(stageId, out var pipeline)
        ? pipeline.Name + (pipeline.ArchivedAt is null ? "" : " (archivé)") : "Pipeline indisponible";

    private string GetStageName(Guid stageId) => stages.TryGetValue(stageId, out var stage)
        ? stage.Name + (stage.ArchivedAt is null ? "" : " (archivée)") : "Étape indisponible";

    private bool isLoading = true;

    private string? errorMessage;
    private string? operationErrorMessage;
    private string? successMessage;
    private OpportunityApiDto? pendingArchive;
    private bool isArchiving;
    private bool hasLoaded;

    [SupplyParameterFromQuery(Name = "notice")]
    public string? Notice { get; set; }

    protected override void OnParametersSet()
    {
        successMessage = Notice switch
        {
            "created" => "Opportunité créée.",
            "updated" => "Opportunité modifiée.",
            _ => null
        };
    }

    protected override Task OnInitializedAsync() => LoadOpportunitiesAsync();

    private Task RetryLoadAsync() => LoadOpportunitiesAsync();

    private async Task LoadOpportunitiesAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var opportunitiesRequest = OpportunityApiService.GetAllAsync();
            var pipelinesRequest = PipelineApiService.GetAllAsync(includeArchived: true);
            await Task.WhenAll(opportunitiesRequest, pipelinesRequest);
            var loadedPipelines = await pipelinesRequest;
            var loadedStages = loadedPipelines.SelectMany(pipeline => pipeline.Stages).ToDictionary(stage => stage.Id);
            var loadedStagePipelines = loadedPipelines.SelectMany(pipeline =>
                pipeline.Stages.Select(stage => new { StageId = stage.Id, Pipeline = pipeline }))
                .ToDictionary(item => item.StageId, item => item.Pipeline);
            opportunities = await opportunitiesRequest;
            pipelines = loadedPipelines;
            stages = loadedStages;
            stagePipelines = loadedStagePipelines;
            if (selectedPipelineId is not null && !pipelines.Any(pipeline => pipeline.Id == selectedPipelineId && pipeline.ArchivedAt is null))
                selectedPipelineId = null;
            hasLoaded = true;
            currentPage = Math.Clamp(currentPage, 1, Math.Max(1, totalPages));
        }
        catch (Exception)
        {
            errorMessage = "Impossible de charger les opportunités.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RequestArchive(OpportunityApiDto opportunity)
    {
        if (isArchiving)
            return;
        pendingArchive = opportunity;
        operationErrorMessage = null;
        successMessage = null;
    }

    private void CancelArchive()
    {
        if (!isArchiving)
        {
            pendingArchive = null;
            operationErrorMessage = null;
        }
    }

    private async Task ConfirmArchiveAsync()
    {
        if (isArchiving || pendingArchive is null)
            return;

        isArchiving = true;
        operationErrorMessage = null;
        successMessage = null;
        try
        {
            var archived = await OpportunityApiService.ArchiveAsync(pendingArchive.Id);
            pendingArchive = null;
            await LoadOpportunitiesAsync();
            if (archived)
                successMessage = "Opportunité archivée.";
            else
                operationErrorMessage = "Cette opportunité n'existe plus.";
        }
        catch (Exception)
        {
            operationErrorMessage = "Impossible d'archiver l'opportunité.";
        }
        finally
        {
            isArchiving = false;
        }
    }

    private bool isKanbanView;

    private void ShowTableView()
    {
        isKanbanView = false;
    }

    private void ShowKanbanView()
    {
        isKanbanView = true;
    }
    private IEnumerable<PipelineStageApiDto> kanbanStages => pipelines
        .Where(pipeline => pipeline.Id == selectedPipelineId)
        .SelectMany(pipeline => pipeline.Stages)
        .Where(stage => stage.ArchivedAt is null || opportunities.Any(opportunity => opportunity.PipelineStageId == stage.Id))
        .OrderBy(stage => stage.SortOrder).ThenBy(stage => stage.Id);

    private IEnumerable<OpportunityApiDto> sortedOpportunities
    {
        get
        {
            var sorted = sortColumn switch
            {
                "CompanyId" => filteredOpportunities.OrderBy(opportunity => opportunity.CompanyId),
                "Pipeline" => filteredOpportunities.OrderBy(opportunity => GetPipelineName(opportunity.PipelineStageId)),
                "Status" => filteredOpportunities.OrderBy(opportunity => GetStageName(opportunity.PipelineStageId)),
                "Priority" => filteredOpportunities.OrderBy(opportunity => OpportunityCodeHelper.GetPriorityLabel(opportunity.PriorityCode)),
                "Location" => filteredOpportunities.OrderBy(opportunity => opportunity.Location),

                _ => filteredOpportunities.OrderBy(opportunity => opportunity.Title)
            };

            return sortAscending
                ? sorted.ThenBy(opportunity => opportunity.Id)
                : sorted.ThenBy(opportunity => opportunity.Id).Reverse();
        }
    }
    private void SetSort(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
            currentPage = 1;
            return;
        }

        sortColumn = column;
        sortAscending = true;
        currentPage = 1;
    }

    private int totalPages =>
    (int)Math.Ceiling(
        sortedOpportunities.Count() / (double)pageSize);

    private IEnumerable<OpportunityApiDto> pagedOpportunities =>
sortedOpportunities
    .Skip((currentPage - 1) * pageSize)
    .Take(pageSize);

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
        }
    }

    private void ResetPagination()
    {
        currentPage = 1;
    }
}
