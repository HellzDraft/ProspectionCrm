@page "/opportunities"

@inject OpportunityApiService OpportunityApiService

<PageTitle>Opportunités</PageTitle>

<h1>Opportunités</h1>

<p>Liste des opportunités de prospection professionnelle.</p>

<NavLink href="/opportunities/create">Ajouter une opportunité</NavLink>

@if (successMessage is not null)
{
    <p role="status">@successMessage</p>
}
@if (operationErrorMessage is not null)
{
    <p role="alert">@operationErrorMessage</p>
}
@if (pendingDeletion is not null)
{
    <section aria-label="Confirmation de suppression">
        <p>Supprimer définitivement l'opportunité « @pendingDeletion.Title » ?
            Les tâches et relances associées (CrmTask) seront également supprimées par cascade.</p>
        <button disabled="@isDeleting" @onclick="ConfirmDeleteAsync">Confirmer la suppression</button>
        <button disabled="@isDeleting" @onclick="CancelDelete">Annuler</button>
        @if (isDeleting)
        {
            <p role="status">Suppression en cours...</p>
        }
    </section>
}
@if (errorMessage is not null)
{
    <p role="alert">@errorMessage</p>
    <button disabled="@(isLoading || isDeleting)" @onclick="RetryLoadAsync">Réessayer</button>
}

<div class="view-selector">
    <button @onclick="ShowTableView">
        Tableau
    </button>

    <button @onclick="ShowKanbanView">
        Kanban
    </button>
</div>

<div class="opportunities-toolbar">
    <input type="text"
           placeholder="Rechercher une opportunité..."
           @bind="searchTerm"
           @bind:event="oninput"
           @bind:after="ResetPagination" />

    <select @bind="selectedPipeline"
            @bind:after="ResetPagination">
        <option value="">Tous les pipelines</option>
        <option value="@PipelineType.DotNet">.NET</option>
        <option value="@PipelineType.MaltFreelance">Malt / Freelance</option>
        <option value="@PipelineType.GameJob">Emploi jeu vidéo</option>
        <option value="@PipelineType.GameBusiness">Business jeu vidéo</option>
    </select>
</div>

@if (isLoading)
{
    <p>Chargement des opportunités...</p>
}
else if (errorMessage is not null && !hasLoaded)
{
}
else if (!filteredOpportunities.Any())
{
    <p>Aucune opportunité ne correspond aux critères.</p>
}
else
{
    @if (isKanbanView && selectedPipeline is null)
    {
        <p>Sélectionnez un pipeline pour afficher le Kanban.</p>
    }
    else if (isKanbanView)
    {
        <div class="kanban-board">
            @foreach (var status in kanbanStatuses)
            {
                <section class="kanban-column">
                    <h2>
                        @OpportunityCodeHelper.GetStatusLabel(status)
                    </h2>

                    @foreach (var opportunity in filteredOpportunities.Where(
                        opportunity => OpportunityCodeHelper.GetStatusKey(opportunity.StatusCode) == status))
                    {
                        <OpportunityApiCard Opportunity="@opportunity" />
                    }
                </section>
            }
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>
                        <button @onclick='() => SetSort("Title")'>
                            Titre
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("CompanyId")'>
                            Entreprise
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("Pipeline")'>
                            Pipeline
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("Status")'>
                            Statut
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("Priority")'>
                            Priorité
                        </button>
                    </th>
                    <th>
                        <button @onclick='() => SetSort("Location")'>
                            Localisation
                        </button>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var opportunity in pagedOpportunities)
                {
                    <tr>
                        <td>@opportunity.Title</td>
                        <td>@OpportunityCodeHelper.GetCompanyLabel(opportunity.CompanyId)</td>

                        <td>
                            <span class="pipeline-badge @GetPipelineClass(opportunity.PipelineCode)">
                                @OpportunityCodeHelper.GetPipelineLabel(opportunity.PipelineCode)
                            </span>
                        </td>

                        <td>@OpportunityCodeHelper.GetStatusLabel(opportunity.StatusCode)</td>

                        <td>
                            <span class="priority-badge @GetPriorityClass(opportunity.PriorityCode)">
                                @OpportunityCodeHelper.GetPriorityLabel(opportunity.PriorityCode)
                            </span>
                        </td>

                        <td>@opportunity.Location</td>

                        <td>
                            <NavLink href="@($"/opportunities/{opportunity.Id}/edit")">Modifier</NavLink>
                            <button disabled="@(isDeleting || isLoading)" @onclick="() => RequestDelete(opportunity)">Supprimer</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button @onclick="PreviousPage"
                    disabled="@(currentPage <= 1)">
                Précédent
            </button>

            <span>
                Page @currentPage sur @totalPages
            </span>

            <button @onclick="NextPage"
                    disabled="@(currentPage >= totalPages)">
                Suivant
            </button>
        </div>
    }
}

@code {
    private List<OpportunityApiDto> opportunities = [];

    private string searchTerm = string.Empty;

    private PipelineType? selectedPipeline;

    private string sortColumn = "Title";
    private bool sortAscending = true;

    private int currentPage = 1;
    private int pageSize = 2;

    private IEnumerable<OpportunityApiDto> filteredOpportunities =>
    opportunities.Where(opportunity =>
        (
            opportunity.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || (opportunity.Location?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            || (opportunity.SourceName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
        )
        &&
        (
            selectedPipeline is null
            || OpportunityCodeHelper.GetPipeline(opportunity.PipelineCode) == selectedPipeline.Value
        ));

    

    private string GetPriorityClass(string code)
    {
        return OpportunityCodeHelper.GetPriority(code) switch
        {
            OpportunityPriority.Low => "priority-low",
            OpportunityPriority.Normal => "priority-normal",
            OpportunityPriority.High => "priority-high",
            _ => string.Empty
        };
    }

    private string GetPipelineClass(string code)
    {
        return OpportunityCodeHelper.GetPipeline(code) switch
        {
            PipelineType.DotNet => "pipeline-dotnet",
            PipelineType.MaltFreelance => "pipeline-malt",
            PipelineType.GameJob => "pipeline-game-job",
            PipelineType.GameBusiness => "pipeline-game-business",
            _ => string.Empty
        };
    }

    private bool isLoading = true;

    private string? errorMessage;
    private string? operationErrorMessage;
    private string? successMessage;
    private OpportunityApiDto? pendingDeletion;
    private bool isDeleting;
    private bool hasLoaded;

    [SupplyParameterFromQuery(Name = "notice")]
    public string? Notice { get; set; }

    protected override void OnParametersSet()
    {
        successMessage = Notice switch
        {
            "created" => "Opportunité créée.",
            "updated" => "Opportunité modifiée.",
            _ => null
        };
    }

    protected override Task OnInitializedAsync() => LoadOpportunitiesAsync();

    private Task RetryLoadAsync() => LoadOpportunitiesAsync();

    private async Task LoadOpportunitiesAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            opportunities = await OpportunityApiService.GetAllAsync();
            hasLoaded = true;
            currentPage = Math.Clamp(currentPage, 1, Math.Max(1, totalPages));
        }
        catch (Exception)
        {
            errorMessage = "Impossible de charger les opportunités.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RequestDelete(OpportunityApiDto opportunity)
    {
        if (isDeleting)
            return;
        pendingDeletion = opportunity;
        operationErrorMessage = null;
        successMessage = null;
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            pendingDeletion = null;
            operationErrorMessage = null;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (isDeleting || pendingDeletion is null)
            return;

        isDeleting = true;
        operationErrorMessage = null;
        successMessage = null;
        try
        {
            var deleted = await OpportunityApiService.DeleteAsync(pendingDeletion.Id);
            pendingDeletion = null;
            await LoadOpportunitiesAsync();
            if (deleted)
                successMessage = "Opportunité supprimée.";
            else
                operationErrorMessage = "Cette opportunité n'existe plus.";
        }
        catch (Exception)
        {
            operationErrorMessage = "Impossible de supprimer l'opportunité.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private bool isKanbanView;

    private void ShowTableView()
    {
        isKanbanView = false;
    }

    private void ShowKanbanView()
    {
        isKanbanView = true;
    }
    private IEnumerable<string> kanbanStatuses =>
        filteredOpportunities.Select(opportunity => OpportunityCodeHelper.GetStatusKey(opportunity.StatusCode))
            .Distinct().OrderBy(OpportunityCodeHelper.GetStatusLabel);

    private IEnumerable<OpportunityApiDto> sortedOpportunities
    {
        get
        {
            var sorted = sortColumn switch
            {
                "CompanyId" => filteredOpportunities.OrderBy(opportunity => opportunity.CompanyId),
                "Pipeline" => filteredOpportunities.OrderBy(opportunity => OpportunityCodeHelper.GetPipelineLabel(opportunity.PipelineCode)),
                "Status" => filteredOpportunities.OrderBy(opportunity => OpportunityCodeHelper.GetStatusLabel(opportunity.StatusCode)),
                "Priority" => filteredOpportunities.OrderBy(opportunity => OpportunityCodeHelper.GetPriorityLabel(opportunity.PriorityCode)),
                "Location" => filteredOpportunities.OrderBy(opportunity => opportunity.Location),

                _ => filteredOpportunities.OrderBy(opportunity => opportunity.Title)
            };

            return sortAscending
                ? sorted.ThenBy(opportunity => opportunity.Id)
                : sorted.ThenBy(opportunity => opportunity.Id).Reverse();
        }
    }
    private void SetSort(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
            currentPage = 1;
            return;
        }

        sortColumn = column;
        sortAscending = true;
        currentPage = 1;
    }

    private int totalPages =>
    (int)Math.Ceiling(
        sortedOpportunities.Count() / (double)pageSize);

    private IEnumerable<OpportunityApiDto> pagedOpportunities =>
sortedOpportunities
    .Skip((currentPage - 1) * pageSize)
    .Take(pageSize);

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
        }
    }

    private void ResetPagination()
    {
        currentPage = 1;
    }
}
