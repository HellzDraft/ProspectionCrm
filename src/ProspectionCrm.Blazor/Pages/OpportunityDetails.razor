@page "/opportunities/{Id:int}"

@inject OpportunityService OpportunityService

@inject NavigationManager NavigationManager

@inject FollowUpActionService FollowUpActionService

<PageTitle>Détail de l'opportunité</PageTitle>

<h1>Détail de l'opportunité</h1>

@if (isLoading)
{
<p>Chargement de l'opportunité...</p>
}
else if (errorMessage is not null)
{
    <p>@errorMessage</p>
}
else if (opportunity is null)
{
    <p>Opportunité introuvable.</p>
}
else
{
    <h2>@opportunity.Title</h2>

    <p>Entreprise : @opportunity.CompanyName</p>
    <p>Pipeline : @OpportunityDisplayHelper.GetPipelineLabel(opportunity.Pipeline)</p>
    <p>
        Statut :
        @OpportunityDisplayHelper.GetStatusLabel(opportunity.Status)
    </p>
    <p>
        Priorité :
        @OpportunityDisplayHelper.GetPriorityLabel(opportunity.Priority)
    </p>
    <p>Localisation : @opportunity.Location</p>
    <NavLink href="@($"/opportunities/{Id}/edit")">
    Modifier
    </NavLink>
    <button @onclick="ShowDeleteConfirmation">
    Supprimer
    </button>

    @if (showDeleteConfirmation)
    {
        <p>Voulez-vous vraiment supprimer cette opportunité ?</p>
        <button @onclick="DeleteOpportunity">
            Confirmer
        </button>
        <button @onclick="CancelDelete">
            Annuler
        </button>
    }

    <h2>Actions / Relances</h2>

    @if (!followUpActions.Any())
    {
        <p>Aucune action associée à cette opportunité.</p>
    }
    else
    {
        @foreach (var action in followUpActions)
        {
            <div>
                <strong>@action.Title</strong>

                <span>
                    @action.DueDate.ToString("dd/MM/yyyy")
                </span>

                @if (action.IsCompleted)
                {
                    <span>Terminée</span>
                }
                else if (FollowUpActionHelper.IsOverdue(action))
                {
                    <span>En retard</span>
                }
                else if (FollowUpActionHelper.IsDueToday(action))
                {
                    <span>Aujourd'hui</span>
                }
                else
                {
                    <span>À venir</span>
                }
            </div>
        }
    }

    <h2>Nouvelle action</h2>

    <EditForm Model="@newAction" OnValidSubmit="AddFollowUpAction">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Titre</label>
            <InputText @bind-Value="newAction.Title" />
            <ValidationMessage For="@(() => newAction.Title)" />
        </div>

        <div>
            <label>Échéance</label>
            <InputDate @bind-Value="newAction.DueDate" />
        </div>

        <div>
            <label>Notes</label>
            <InputText @bind-Value="newAction.Notes" />
        </div>

        <button type="submit">
            Ajouter l'action
        </button>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private OpportunityDto? opportunity;

    private bool isLoading = true;

    private string? errorMessage;

    private bool showDeleteConfirmation;

    private FollowUpActionFormModel newAction = new();

    private List<FollowUpActionDto> followUpActions = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            opportunity = await OpportunityService.GetByIdAsync(Id);
        }
        catch (Exception)
        {
            errorMessage = "Impossible de charger de l'opportunité.";
        }
        finally
        {
            isLoading = false;
        }

        if (opportunity is not null)
        {
            followUpActions =
                await FollowUpActionService.GetByOpportunityIdAsync(opportunity.Id);
        }
    }

    private void ShowDeleteConfirmation()
    {
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
    }

    private async Task DeleteOpportunity()
    {
        var deleted = await OpportunityService.DeleteAsync(Id);

        if (deleted)
        {
            NavigationManager.NavigateTo("/opportunities");
        }
    }

    private async Task AddFollowUpAction()
    {
        if (opportunity is null)
        {
            return;
        }

        var action = new FollowUpActionDto
        {
            Title = newAction.Title,
            DueDate = newAction.DueDate,
            IsCompleted = false,
            OpportunityId = opportunity.Id,
            OpportunityTitle = opportunity.Title,
            Notes = newAction.Notes
        };

        await FollowUpActionService.AddAsync(action);

        followUpActions.Add(action);
        newAction = new FollowUpActionFormModel();
    }
}