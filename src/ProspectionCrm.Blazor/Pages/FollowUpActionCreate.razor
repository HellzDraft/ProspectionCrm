@page "/actions/create"

@inject FollowUpActionService FollowUpActionService
@inject NavigationManager NavigationManager

<PageTitle>Ajouter une action</PageTitle>

<h1>Ajouter une action</h1>

<EditForm Model="@model" OnValidSubmit="HandleValidSubmit">

        <DataAnnotationsValidator />

        <ValidationSummary />

        <div>
            <label>Titre</label>

            <InputText @bind-Value="model.Title" />

            <ValidationMessage For="@(() => model.Title)" />
        </div>

        <div>
            <label>Échéance</label>

            <InputDate @bind-Value="model.DueDate" />
        </div>


        <div>
            <label>Notes</label>

            <InputText @bind-Value="model.Notes" />
        </div>

        <button type="submit">
            Ajouter
        </button>

</EditForm>

@code
{
    private FollowUpActionFormModel model = new();

    private async Task HandleValidSubmit()
    {
        var action = new FollowUpActionDto
        {
            Title = model.Title,
            DueDate = model.DueDate,
            IsCompleted = false,
            OpportunityId = null,
            OpportunityTitle = string.Empty,
            Notes = model.Notes
        };

        await FollowUpActionService.AddAsync(action);

        NavigationManager.NavigateTo("/actions");
    }
}