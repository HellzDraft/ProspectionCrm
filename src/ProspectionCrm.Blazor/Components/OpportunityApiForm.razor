<EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <fieldset disabled="@IsSubmitting">
        <div>
            <label for="opportunity-title">Titre</label>
            <InputText id="opportunity-title" @bind-Value="Model.Title" />
            <ValidationMessage For="@(() => Model.Title)" />
        </div>
        <div>
            <label for="opportunity-pipeline">Pipeline</label>
            <InputSelect id="opportunity-pipeline" @bind-Value="Model.PipelineId" @bind-Value:after="OnPipelineChanged">
                <option value="">Sélectionner un pipeline</option>
                @foreach (var pipeline in availablePipelines)
                {
                    <option value="@pipeline.Id">@pipeline.Name@(pipeline.ArchivedAt is not null ? " (archivé)" : "")</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.PipelineId)" />
        </div>
        <div>
            <label for="opportunity-stage">Étape</label>
            <InputSelect id="opportunity-stage" @bind-Value="Model.PipelineStageId">
                <option value="">Sélectionner une étape</option>
                @foreach (var stage in availableStages)
                {
                    <option value="@stage.Id">@stage.Name@(stage.ArchivedAt is not null ? " (archivée)" : "")</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.PipelineStageId)" />
        </div>
        <div>
            <label for="opportunity-priority">Priorité</label>
            <InputSelect id="opportunity-priority" @bind-Value="Model.PriorityCode">
                @foreach (var priority in Enum.GetValues<OpportunityPriority>())
                {
                    <option value="@OpportunityCodeHelper.GetPriorityCode(priority)">@OpportunityDisplayHelper.GetPriorityLabel(priority)</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.PriorityCode)" />
        </div>
        <div>
            <label for="opportunity-location">Localisation</label>
            <InputText id="opportunity-location" @bind-Value="Model.Location" />
            <ValidationMessage For="@(() => Model.Location)" />
        </div>
        <button type="submit" disabled="@IsSubmitting">@SubmitText</button>
    </fieldset>
</EditForm>

@code {
    [Parameter] public OpportunityApiFormModel Model { get; set; } = default!;
    [Parameter] public IReadOnlyList<PipelineApiDto> Pipelines { get; set; } = [];
    [Parameter] public Guid? OriginalStageId { get; set; }
    [Parameter] public string SubmitText { get; set; } = "Enregistrer";
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    private IEnumerable<PipelineApiDto> availablePipelines => Pipelines.Where(pipeline =>
        (pipeline.ArchivedAt is null && pipeline.Stages.Any(stage => stage.ArchivedAt is null))
        || pipeline.Stages.Any(stage => stage.Id == OriginalStageId)).OrderBy(pipeline => pipeline.Name);

    private IEnumerable<PipelineStageApiDto> availableStages => Pipelines
        .Where(pipeline => pipeline.Id == Model.PipelineId)
        .SelectMany(pipeline => pipeline.Stages.Where(stage =>
            (pipeline.ArchivedAt is null && stage.ArchivedAt is null) || stage.Id == OriginalStageId))
        .OrderBy(stage => stage.SortOrder).ThenBy(stage => stage.Id);

    private void OnPipelineChanged()
    {
        if (!availableStages.Any(stage => stage.Id == Model.PipelineStageId))
            Model.PipelineStageId = null;
    }

    private async Task HandleValidSubmit()
    {
        if (!IsSubmitting)
            await OnValidSubmit.InvokeAsync();
    }
}
